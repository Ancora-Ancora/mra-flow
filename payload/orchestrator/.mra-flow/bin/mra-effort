#!/usr/bin/env python3
"""Effort of mra-flow changes in effective hours, and estimate-vs-actual reports.

  mra-effort measure <change-id> [--gap MIN] [--alias TEXT ...] [--logs DIR ...] [--json]
      hours the agent or the user was active on the change, per phase, from the
      Claude Code session logs of this orchestrator; plus the unattributed stretches
      in the change's period, to assign or ignore
  mra-effort breakdown <change-id> [--gap MIN] [--alias TEXT ...] [--logs DIR ...] [--json]
      Markdown table for the archive summary: the change (epic) first with its total
      hours and tokens per model, then every plan task with its subagents' hours and
      tokens per model, then `other` (change subagents matching no task) and `session`
      (the controller's own work)
  mra-effort record <initiative> <change-id> --phase PHASE=HOURS ... [--actual HOURS]
      write the confirmed hours into docs/roadmap/<initiative>.md (Actual (h) and
      the "Actuals by phase" table)
  mra-effort report <initiative>
      recompute the roadmap's Total lines and regenerate
      docs/roadmap/<initiative>-effort.md (variance by slice, hours by phase)

Active time: consecutive timestamped events of a session (its subagents included)
no more than --gap minutes apart (default 10). Each interval goes to the /mra-*
command in progress in that session, and counts for <change-id> when the command's
arguments name it (or one of --alias). Parallel sessions are summed, not merged.

breakdown attributes each subagent (its first prompt) to the change by the change id,
an alias or a task's bd id, and to a task by the bd id, else by a `task-N-` path; tokens
are input + cache creation + cache read + output of its assistant records.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
ROADMAPS = ROOT / "docs" / "roadmap"
CHANGES = ROOT / "openspec" / "changes"

PHASES = ("grill", "prototype", "research", "propose", "track", "build", "verify", "fix",
          "update", "archive", "hotfix", "other")
COMMAND_PHASE = {
    "mra-grill": "grill", "mra-prototype": "prototype", "mra-research": "research",
    "mra-propose": "propose", "mra-track": "track", "mra-build": "build",
    "mra-verify": "verify", "mra-qa-ui": "verify", "mra-fix": "fix", "mra-update": "update",
    "mra-archive": "archive", "mra-hotfix": "hotfix", "mra-drift": "other",
    "mra-sync": "other", "mra-explore": "other", "mra-roadmap": "other",
}
COMMAND = re.compile(r"<command-name>/?([\w:.-]+)</command-name>"
                     r"(?:\s*<command-args>(.*?)</command-args>)?", re.S)
RANGE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*(?:[-–]\s*(\d+(?:\.\d+)?))?\s*$")
INJECTED = ("<", "Base directory for this skill", "Skill /", "(Re-invocation", "[Request interrupted")
MIN_STRETCH_H = 0.05  # unattributed stretches shorter than 3 minutes are noise


class Refusal(Exception):
    pass


# ---------------------------------------------------------------- measure

def default_logs() -> list[Path]:
    config = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    return [config / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(ROOT))]


def _timestamp(record: dict) -> float | None:
    value = record.get("timestamp")
    if not isinstance(value, str):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _text(record: dict) -> str:
    content = (record.get("message") or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(b.get("text", "") for b in content
                        if isinstance(b, dict) and b.get("type") == "text")
    return ""


def _records(path: Path):
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if isinstance(record, dict):
                yield record


@dataclass
class Event:
    t: float
    command: tuple[str, str] | None = None  # (name, args) of an mra command typed here
    prompt: str = ""                          # first words of a plain user prompt


def session_events(main: Path) -> list[Event]:
    events = []
    for record in _records(main):
        t = _timestamp(record)
        if t is None:
            continue
        event = Event(t)
        if record.get("type") == "user":
            text = _text(record)
            found = COMMAND.search(text)
            if found:
                event.command = (found.group(1), (found.group(2) or "").strip())
            elif text.strip() and not text.lstrip().startswith(INJECTED):
                event.prompt = " ".join(text.split())[:70]
        events.append(event)
    for sub in sorted((main.parent / main.stem / "subagents").glob("*.jsonl")):
        events.extend(Event(t) for t in (_timestamp(r) for r in _records(sub)) if t is not None)
    events.sort(key=lambda e: e.t)
    return events


def known_change_ids() -> set[str]:
    ids = set()
    if CHANGES.is_dir():
        for path in CHANGES.iterdir():
            if path.is_dir() and path.name != "archive":
                ids.add(path.name)
        for path in (CHANGES / "archive").glob("*"):
            if path.is_dir():
                ids.add(re.sub(r"^\d{4}-\d{2}-\d{2}-", "", path.name))
    return ids


def _names(args: str, name: str) -> bool:
    return re.search(rf"(?<![\w-]){re.escape(name)}(?![\w-])", args) is not None


@dataclass
class Stretch:
    session: str
    start: float
    end: float
    hours: float
    context: str
    prompt: str


@dataclass
class Measure:
    phases: dict[str, float] = field(default_factory=dict)
    unattributed: list[Stretch] = field(default_factory=list)
    sessions: int = 0
    intervals: dict[Path, list[tuple[float, float]]] = field(default_factory=dict)


def measure(change: str, aliases: list[str], logs: list[Path], gap_min: float) -> Measure:
    others = known_change_ids() - {change}
    names = [change, *aliases]
    gap = gap_min * 60
    result = Measure()
    runs: list[Stretch] = []
    period: list[float] = []
    for directory in logs:
        for main in sorted(directory.glob("*.jsonl")):
            events = session_events(main)
            context: tuple[str, str] | None = None
            prompt, previous, run = "", None, None
            for event in events:
                if previous is not None and event.t - previous <= gap:
                    hours = (event.t - previous) / 3600
                    phase = None
                    if context and context[0] in COMMAND_PHASE and any(_names(context[1], n) for n in names):
                        phase = COMMAND_PHASE[context[0]]
                    if phase:
                        result.phases[phase] = result.phases.get(phase, 0.0) + hours
                        period.extend((previous, event.t))
                        result.intervals.setdefault(main, []).append((previous, event.t))
                        run = None
                    elif not (context and any(_names(context[1], o) for o in others)):
                        label = f"/{context[0]} {context[1]}".strip() if context else "(no command)"
                        if run is None or run.context != label or previous - run.end > gap:
                            run = Stretch(main.stem[:8], previous, event.t, 0.0, label, prompt)
                            runs.append(run)
                        run.end, run.hours = event.t, run.hours + hours
                    else:
                        run = None
                else:
                    run = None
                if event.command and event.command[0] not in ("clear",):
                    if event.command[0].startswith("mra-"):
                        context, prompt = event.command, ""
                if event.prompt:
                    prompt = event.prompt  # the latest prompt labels the next stretch
                    if run is not None and not run.prompt:
                        run.prompt = prompt
                previous = event.t
            result.sessions += 1
    if period:
        first, last = min(period) - 24 * 3600, max(period)
        result.unattributed = sorted((r for r in runs
                                      if r.hours >= MIN_STRETCH_H and r.end > first and r.start < last),
                                     key=lambda r: r.start)
    return result


def _clock(t: float) -> str:
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%d %H:%M")


def print_measure(change: str, result: Measure, gap: float, as_json: bool) -> None:
    total = sum(result.phases.values())
    if as_json:
        print(json.dumps({
            "change": change, "gap_minutes": gap, "hours": round(total, 2),
            "phases": {p: round(h, 2) for p, h in sorted(result.phases.items(), key=lambda x: PHASES.index(x[0]))},
            "unattributed": [{"session": s.session, "start": _clock(s.start), "end": _clock(s.end),
                              "hours": round(s.hours, 2), "context": s.context, "prompt": s.prompt}
                             for s in result.unattributed],
        }, indent=2))
        return
    print(f"{change}: {fmt(total)} h attributed (gap {fmt(gap)} min, {result.sessions} sessions)")
    for phase in PHASES:
        if result.phases.get(phase):
            hours = result.phases[phase]
            print(f"  {phase:<10} {fmt(hours) if hours >= 0.05 else '<0.1'} h")
    if result.unattributed:
        print("unattributed stretches in the change's period (assign to a phase or ignore):")
        for i, s in enumerate(result.unattributed, 1):
            print(f"  {i:>2}  {_clock(s.start)}-{_clock(s.end)[11:]} UTC  {fmt(s.hours)} h  "
                  f"session {s.session}  {s.context}  \"{s.prompt}\"")


# ---------------------------------------------------------------- breakdown

@dataclass
class Task:
    number: str
    bd_id: str
    title: str


def plan_tasks(change: str) -> list[Task]:
    plans = [CHANGES / change / "plan.md", *sorted((CHANGES / "archive").glob(f"*-{change}/plan.md"))]
    plan = next((p for p in plans if p.is_file()), None)
    if plan is None:
        return []
    heading = re.compile(r"^###\s+Task\s+(\d+):\s*\[([^\]]+)\]\s*(.*?)\s*$")
    return [Task(m.group(1), m.group(2), m.group(3))
            for m in map(heading.match, plan.read_text(encoding="utf-8").splitlines()) if m]


def model_name(model: str) -> str:
    base = re.sub(r"-\d{8}$", "", model.removeprefix("anthropic."))
    found = re.fullmatch(r"claude-([a-z]+)-(\d+(?:-\d+)*)", base)
    if not found:
        return base or "unknown"
    return f"{found.group(1).capitalize()} {found.group(2).replace('-', '.')}"


def _usage(records: list[dict]) -> list[tuple[float, str, int, int]]:
    """(time, friendly model, tokens, output tokens) per distinct assistant message."""
    last: dict[str, dict] = {}
    for i, r in enumerate(records):
        message = r.get("message") or {}
        if r.get("type") != "assistant" or not isinstance(message.get("usage"), dict) or not message.get("model"):
            continue
        last[message.get("id") or f"#{i}"] = r
    out = []
    for r in last.values():
        u, t = r["message"]["usage"], _timestamp(r)
        if t is None:
            continue
        output = int(u.get("output_tokens") or 0)
        total = output + sum(int(u.get(k) or 0) for k in
                             ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        out.append((t, model_name(r["message"]["model"]), total, output))
    return out


def _active(times: list[float], gap: float) -> float:
    times = sorted(times)
    return sum(b - a for a, b in zip(times, times[1:]) if b - a <= gap) / 3600


def _change_named(text: str, name: str) -> bool:
    # also the SDD workspace folder, plan-<change-id>/
    return re.search(rf"(?:(?<![\w-])|(?<=plan-)){re.escape(name)}(?![\w-])", text) is not None


def _bd_named(text: str, bd_id: str) -> bool:
    return re.search(rf"(?<![\w-]){re.escape(bd_id)}(?![\w-]|\.\d)", text) is not None


@dataclass
class Row:
    key: str
    label: str
    bd_id: str = ""
    title: str = ""
    hours: float = 0.0
    models: dict[str, list[int]] = field(default_factory=dict)  # model -> [tokens, output]

    def add(self, usage) -> None:
        for _, model, tokens, output in usage:
            entry = self.models.setdefault(model, [0, 0])
            entry[0] += tokens
            entry[1] += output


def breakdown(change: str, aliases: list[str], logs: list[Path], gap_min: float) -> dict:
    gap = gap_min * 60
    measured = measure(change, aliases, logs, gap_min)
    tasks = plan_tasks(change)
    names = [change, *aliases]
    rows = {t.number: Row(t.number, f"Task {t.number} [{t.bd_id}] {t.title}", t.bd_id, t.title) for t in tasks}
    other, session = Row("other", "other (change subagents outside the tasks)"), Row("session", "session (controller)")
    for directory in logs:
        for main in sorted(directory.glob("*.jsonl")):
            main_records = list(_records(main))
            spans = measured.intervals.get(main, [])
            session.add([u for u in _usage(main_records)
                         if any(a < u[0] <= b for a, b in spans)])
            for sub in sorted((main.parent / main.stem / "subagents").glob("*.jsonl")):
                records = list(_records(sub))
                first = next((_text(r) for r in records if r.get("type") == "user"), "")
                by_id = next((t for t in tasks if _bd_named(first, t.bd_id)), None)
                if by_id is None and not any(_change_named(first, n) for n in names):
                    continue
                if by_id is None:
                    found = re.search(rf"plan-{re.escape(change)}/task-(\d+)-", first)
                    by_id = next((t for t in tasks if found and t.number == found.group(1)), None)
                row = rows[by_id.number] if by_id else other
                usage = _usage(records)
                row.add(usage)
                row.hours += _active([t for t in (_timestamp(r) for r in records) if t is not None], gap)
    ordered = [*rows.values(), other, session]
    totals: dict[str, list[int]] = {}
    for row in ordered:
        for model, (tokens, output) in row.models.items():
            entry = totals.setdefault(model, [0, 0])
            entry[0] += tokens
            entry[1] += output

    def models(table: dict[str, list[int]]) -> list[dict]:
        total = sum(v[0] for v in table.values())
        return [{"model": m, "tokens": v[0], "output_tokens": v[1], "share": v[0] / total if total else 0.0}
                for m, v in sorted(table.items(), key=lambda kv: -kv[1][0])]

    return {
        "change": change, "gap_minutes": gap_min,
        "epic": {"hours": sum(measured.phases.values()), "task_hours": sum(r.hours for r in rows.values()),
                 "tokens": sum(v[0] for v in totals.values()),
                 "output_tokens": sum(v[1] for v in totals.values()), "models": models(totals)},
        "rows": [{"key": r.key, "label": r.label, "bd_id": r.bd_id, "title": r.title, "hours": r.hours,
                  "tokens": sum(v[0] for v in r.models.values()), "models": models(r.models)}
                 for r in ordered if r.key in rows or r.models or r.hours],
    }


def print_breakdown(data: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(data, indent=2))
        return
    def hours(value: float) -> str:
        return f"{value:.1f}"
    def lines(item: str, time: str, models: list[dict]):
        if not models:
            yield f"| {item} | {time} | | | | |"
        for i, m in enumerate(models):
            yield (f"| {item if i == 0 else ''} | {time if i == 0 else ''} | {m['model']} | {m['tokens']:,} | "
                   f"{m['output_tokens']:,} | {m['share'] * 100:.0f}% |")
    epic = data["epic"]
    out = ["| Item | Time (h) | Model | Tokens | Output tokens | Share |", "|---|---|---|---|---|---|",
           *lines(f"**{data['change']}** (epic)", f"{hours(epic['hours'])} total; tasks {hours(epic['task_hours'])}",
                  epic["models"])]
    for row in data["rows"]:
        out.extend(lines(row["label"], hours(row["hours"]) if row["key"] != "session" else "", row["models"]))
    print("\n".join(out))


# ---------------------------------------------------------------- roadmap tables

def fmt(value: float) -> str:
    text = f"{value:.1f}"
    return text[:-2] if text.endswith(".0") else text


def parse_range(cell: str) -> tuple[float, float] | None:
    found = RANGE.match(cell.replace(",", "."))
    if not found:
        return None
    low = float(found.group(1))
    return low, float(found.group(2)) if found.group(2) else low


def parse_hours(cell: str) -> float | None:
    found = parse_range(cell)
    return found[0] if found and found[0] == found[1] else None


@dataclass
class Table:
    start: int            # index of the header line
    end: int              # index after the last row
    header: list[str]
    rows: list[list[str]]


def _cells(line: str) -> list[str]:
    return [c.strip() for c in line.strip().strip("|").split("|")]


def find_table(lines: list[str], heading: str) -> Table | None:
    try:
        at = lines.index(heading)
    except ValueError:
        return None
    i = at + 1
    while i < len(lines) and not lines[i].startswith("|"):
        if lines[i].startswith("## "):
            return None
        i += 1
    if i >= len(lines):
        return None
    start, header = i, _cells(lines[i])
    i += 2
    rows = []
    while i < len(lines) and lines[i].startswith("|"):
        rows.append(_cells(lines[i]))
        i += 1
    return Table(start, i, header, rows)


def _line(cells: list[str]) -> str:
    return "| " + " | ".join(cells) + " |"


def render(header: list[str], rows: list[list[str]]) -> list[str]:
    return [_line(header), "|" + "---|" * len(header), *(_line(r) for r in rows)]


def roadmap_path(initiative: str) -> Path:
    path = ROADMAPS / f"{initiative}.md"
    if not path.exists():
        raise Refusal(f"no roadmap {path.relative_to(ROOT)}")
    return path


def slices(lines: list[str]) -> tuple[Table, dict[str, int]]:
    table = find_table(lines, "## Slices")
    if table is None:
        raise Refusal("the roadmap has no Slices table")
    if any(h.endswith("(d)") for h in table.header):
        raise Refusal("the roadmap is in days: rename the (d) columns to (h) and convert the figures to hours")
    col = {h: i for i, h in enumerate(table.header)}
    for needed in ("Change id", "Goal", "Estimate (h)", "Revised (h)", "Status", "Epic", "Actual (h)"):
        if needed not in col:
            raise Refusal(f"the Slices table has no '{needed}' column")
    return table, col


def record(initiative: str, change: str, phases: dict[str, float], actual: float | None) -> None:
    path = roadmap_path(initiative)
    lines = path.read_text(encoding="utf-8").splitlines()
    table, col = slices(lines)
    row = next((r for r in table.rows if r[col["Change id"]] == change), None)
    if row is None:
        raise Refusal(f"{change} is not a slice of {initiative}")
    total = actual if actual is not None else sum(phases.values())
    row[col["Actual (h)"]] = fmt(total)
    lines[table.start:table.end] = render(table.header, table.rows)

    header = ["Change id", *PHASES, "Total"]
    by_phase = find_table(lines, "## Actuals by phase")
    new_row = [change, *(fmt(phases[p]) if phases.get(p) else "" for p in PHASES), fmt(total)]
    if by_phase is None:
        at = next((i for i, l in enumerate(lines) if l == "## Total"), len(lines))
        lines[at:at] = ["## Actuals by phase", "",
                        "Effective hours per phase, written by `mra-effort record` at archive.", "",
                        *render(header, [new_row]), ""]
    else:
        rows = [r for r in by_phase.rows if r[0] != change] + [new_row]
        order = [r[col["Change id"]] for r in table.rows]
        rows.sort(key=lambda r: order.index(r[0]) if r[0] in order else len(order))
        lines[by_phase.start:by_phase.end] = render(header, rows)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def _sum(ranges: list[tuple[float, float]]) -> str:
    return f"{fmt(sum(r[0] for r in ranges))}–{fmt(sum(r[1] for r in ranges))}"


def report(initiative: str) -> Path:
    path = roadmap_path(initiative)
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    table, col = slices(lines)
    title = next((l[2:] for l in lines if l.startswith("# ")), initiative)
    live = [r for r in table.rows if r[col["Status"]] != "dropped"]

    estimates = [parse_range(r[col["Estimate (h)"]]) for r in live]
    forecast, done_actual, done_estimates, done = [], 0.0, [], 0
    for r, est in zip(live, estimates):
        actual = parse_hours(r[col["Actual (h)"]]) if r[col["Status"]] == "done" else None
        if actual is not None:
            done += 1
            done_actual += actual
            forecast.append((actual, actual))
            if est:
                done_estimates.append(est)
        else:
            chosen = parse_range(r[col["Revised (h)"]]) or est
            if chosen:
                forecast.append(chosen)
    totals = [
        f"- Estimate: {_sum([e for e in estimates if e])} h",
        f"- Forecast: {_sum(forecast)} h",
        f"- Progress: {done}/{len(live)} slices; actual {fmt(done_actual)} h vs. estimated "
        f"{_sum(done_estimates) if done_estimates else '–'} h",
    ]
    at = next((i for i, l in enumerate(lines) if l == "## Total"), None)
    if at is not None:
        end = next((i for i in range(at + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
        lines[at:end] = ["## Total", "", *totals, ""]
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")

    # Actual hours per phase, from the "Actuals by phase" table written by record.
    phase_hours: dict[str, dict[str, float]] = {}
    by_phase = find_table(lines, "## Actuals by phase")
    if by_phase:
        for r in by_phase.rows:
            phase_hours[r[0]] = {by_phase.header[i]: h for i in range(1, len(r))
                                 if i < len(by_phase.header) and by_phase.header[i] in PHASES
                                 and (h := parse_hours(r[i]))}
    used = [p for p in PHASES if any(p in hours for hours in phase_hours.values())]

    variance_rows, sum_est, sum_act = [], 0.0, 0.0
    sum_phase = {p: 0.0 for p in used}
    for r, est in zip(live, estimates):
        actual = parse_hours(r[col["Actual (h)"]]) if r[col["Status"]] == "done" else None
        upper = est[1] if est else None
        cells = [r[col.get("#", 0)] if "#" in col else "", r[col["Epic"]], r[col["Change id"]],
                 r[col["Goal"]], r[col["Estimate (h)"]] or "–", fmt(upper) if upper is not None else "–",
                 fmt(actual) if actual is not None else "–"]
        if actual is not None and upper:
            diff = actual - upper
            sum_est, sum_act = sum_est + upper, sum_act + actual
            cells += [f"{diff:+.1f}", f"{diff / upper * 100:+.0f}%", "🔴" if diff > 0 else "🟢"]
        else:
            cells += ["", "", "⚪" if actual is None else ""]
        hours = phase_hours.get(r[col["Change id"]], {}) if actual is not None else {}
        for p in used:
            sum_phase[p] += hours.get(p, 0.0)
        cells += [fmt(hours[p]) if p in hours else "" for p in used]
        variance_rows.append(cells)
    if sum_est or any(sum_phase.values()):
        diff = sum_act - sum_est
        total = ["", "", "**Total**", "done slices", "", fmt(sum_est) if sum_est else "",
                 fmt(sum(parse_hours(r[6]) or 0 for r in variance_rows))]
        total += ([f"{diff:+.1f}", f"{diff / sum_est * 100:+.0f}%", "🔴" if diff > 0 else "🟢"]
                  if sum_est else ["", "", ""])
        total += [fmt(sum_phase[p]) for p in used]
        variance_rows.append(total)

    out = [f"<!-- generated by .mra-flow/bin/mra-effort report {initiative}; do not edit -->",
           f"# {title}: estimate vs. actual", "",
           "Hours are effective hours. Estimate range = the original estimate; estimated = its upper bound; "
           "variance = actual − estimated, totalled over the slices that have both. 🔴 over the estimate, "
           "🟢 within it, ⚪ not done yet. The mra-* columns are the actual hours of each phase.", "",
           "## Variance by slice", "",
           *render(["#", "Epic", "Change id", "Summary", "Estimate range (h)", "Estimated (h)", "Actual (h)",
                    "Variance (h)", "Variance (%)", "", *(f"mra-{p}" if p != "other" else "other" for p in used)],
                   variance_rows), ""]
    target = ROADMAPS / f"{initiative}-effort.md"
    target.write_text("\n".join(out), encoding="utf-8")
    return target


# ---------------------------------------------------------------- CLI

def _phase_arg(value: str) -> tuple[str, float]:
    name, _, hours = value.partition("=")
    if name not in PHASES:
        raise argparse.ArgumentTypeError(f"unknown phase {name!r}; one of {', '.join(PHASES)}")
    try:
        return name, float(hours.replace(",", "."))
    except ValueError:
        raise argparse.ArgumentTypeError(f"{value!r} is not PHASE=HOURS") from None


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="mra-effort", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    m = sub.add_parser("measure")
    m.add_argument("change")
    m.add_argument("--gap", type=float, default=10.0)
    m.add_argument("--alias", action="append", default=[])
    m.add_argument("--logs", action="append", type=Path)
    m.add_argument("--json", action="store_true")
    b = sub.add_parser("breakdown")
    b.add_argument("change")
    b.add_argument("--gap", type=float, default=10.0)
    b.add_argument("--alias", action="append", default=[])
    b.add_argument("--logs", action="append", type=Path)
    b.add_argument("--json", action="store_true")
    r = sub.add_parser("record")
    r.add_argument("initiative")
    r.add_argument("change")
    r.add_argument("--phase", action="append", type=_phase_arg, default=[])
    r.add_argument("--actual", type=float)
    p = sub.add_parser("report")
    p.add_argument("initiative")
    args = parser.parse_args(argv)
    try:
        if args.cmd in ("measure", "breakdown"):
            logs = args.logs or default_logs()
            missing = [d for d in logs if not d.is_dir()]
            if missing:
                raise Refusal(f"no Claude Code session logs in {missing[0]} (use --logs DIR)")
            if args.cmd == "breakdown":
                print_breakdown(breakdown(args.change, args.alias, logs, args.gap), args.json)
            else:
                print_measure(args.change, measure(args.change, args.alias, logs, args.gap), args.gap, args.json)
        elif args.cmd == "record":
            phases: dict[str, float] = {}
            for name, hours in args.phase:
                phases[name] = phases.get(name, 0.0) + hours
            if not phases and args.actual is None:
                raise Refusal("give --phase PHASE=HOURS (one or more) or --actual HOURS")
            record(args.initiative, args.change, phases, args.actual)
            print(f"recorded {args.change} in docs/roadmap/{args.initiative}.md")
        else:
            print(f"wrote {report(args.initiative).relative_to(ROOT)}")
    except Refusal as exc:
        print(f"mra-effort: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
