#!/usr/bin/env python3
"""Fake openspec CLI for tests: logs calls, fakes --version and init."""
import os
import pathlib
import sys

SKILLS = ("openspec-explore", "openspec-propose", "openspec-update-change",
          "openspec-sync-specs", "openspec-archive-change")

with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("openspec " + " ".join(sys.argv[1:]) + "\n")
if sys.argv[1:2] == ["--version"]:
    print(os.environ.get("FAKE_OPENSPEC_VERSION", "1.16.0"))
elif sys.argv[1:2] == ["init"]:
    root = pathlib.Path(sys.argv[-1]).resolve()
    (root / "openspec").mkdir(parents=True, exist_ok=True)
    (root / "openspec" / "config.yaml").write_text("schema: spec-driven\n")
    if os.environ.get("FAKE_OPENSPEC_SKIP_SKILLS") != "1":
        for name in SKILLS:
            d = root / ".claude" / "skills" / name
            d.mkdir(parents=True, exist_ok=True)
            (d / "SKILL.md").write_text(f"# {name}\n")
