#!/usr/bin/env python3
"""Fake bd CLI for tests: logs calls, `init` creates .beads/."""
import os
import pathlib
import sys

with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("bd " + " ".join(sys.argv[1:]) + "\n")
if sys.argv[1:2] == ["init"]:
    pathlib.Path(".beads").mkdir(exist_ok=True)
elif sys.argv[1:2] == ["--version"]:
    print("bd version 1.3.2")
